# Leave both keys blank to run the offline demo. No paid API is required.
# `bossloop demo` always uses the mock crew, even if a key is present.
# `bossloop run` uses OpenAI when OPENAI_API_KEY is set, otherwise Gemini, otherwise the mock crew.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# auto | mock | openai | gemini
BOSSLOOP_PROVIDER=auto

# Where checkpoints are written. Defaults to ./runs
# BOSSLOOP_RUNS_DIR=./runs
